# Template for /opt/local-llm/.env  –  NEVER commit the real .env!
# Create:  cp .env.example .env && chmod 600 .env  and fill in the values

# Shared API key the AI gateways (LiteLLM) use to call this server.
# Generate:  echo "sk-local-$(openssl rand -hex 24)"
LOCAL_LLM_API_KEY=<LOCAL_LLM_API_KEY>

# --- Ollama tuning (optional, defaults in docker-compose.yml) ---
# Parallel requests per model; RAM for KV cache grows with NUM_PARALLEL x CONTEXT_LENGTH.
OLLAMA_NUM_PARALLEL=2
# Default context window in tokens.
OLLAMA_CONTEXT_LENGTH=8192
# How long a model stays loaded after the last request.
OLLAMA_KEEP_ALIVE=24h
