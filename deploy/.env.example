# Template for /opt/ai-stack/.env  –  NEVER commit the real .env!
# Create:    cp .env.example .env && chmod 600 .env   and fill in the values
#            (or let deploy/prepare.sh generate it)
# Generate:  openssl rand -hex 32

# --- Model provider ---
# API key from https://openrouter.ai/settings/keys (starts with sk-or-v1-)
OPENROUTER_API_KEY=<OPENROUTER_API_KEY>

# --- Part 2 of the training (optional for part 1) ---
# IP address of the server for HTTPS via Caddy (goes into the TLS certificate)
SERVER_IP=<SERVER_IP>
# Anthropic API key from https://console.anthropic.com/settings/keys (starts with sk-ant-)
ANTHROPIC_API_KEY=<ANTHROPIC_API_KEY>
# PromptGuard guardrail API key from https://promptguard.co (free tier available)
PROMPTGUARD_API_KEY=<PROMPTGUARD_API_KEY>

# --- LiteLLM ---
# Master key = proxy admin key, must start with "sk-":  sk-$(openssl rand -hex 32)
LITELLM_MASTER_KEY=<LITELLM_MASTER_KEY>
# Salt key = encryption of credentials stored in the DB:  sk-$(openssl rand -hex 32)
# NEVER change it after the first start (stored keys could not be decrypted).
LITELLM_SALT_KEY=<LITELLM_SALT_KEY>
# Admin UI login (http://<SERVER_IP>:4000/ui)
UI_USERNAME=admin
UI_PASSWORD=<UI_PASSWORD>

# --- PostgreSQL ---
POSTGRES_PASSWORD=<POSTGRES_PASSWORD>

# --- Open WebUI ---
# Virtual key created in LiteLLM (POST /key/generate, alias open-webui) – NOT the master key
OPENWEBUI_LITELLM_KEY=<OPENWEBUI_LITELLM_KEY>
# Signs session tokens:  openssl rand -hex 32
WEBUI_SECRET_KEY=<WEBUI_SECRET_KEY>
# URL where users open the UI (links, SSO)
WEBUI_URL=http://<SERVER_IP>:3000
