# Vzor pro /opt/ai-stack/.env  –  skutečný .env NIKDY necommitovat!
# Vytvoření:   cp .env.example .env && chmod 600 .env   a doplnit hodnoty
# Generování:  openssl rand -hex 32

# --- Poskytovatel modelu ---
# API klíč z https://openrouter.ai/settings/keys (začíná sk-or-v1-)
OPENROUTER_API_KEY=<OPENROUTER_API_KEY>

# --- LiteLLM ---
# Master key = admin klíč proxy, musí začínat "sk-":  sk-$(openssl rand -hex 32)
LITELLM_MASTER_KEY=<LITELLM_MASTER_KEY>
# Salt key = šifrování credentials v DB:  sk-$(openssl rand -hex 32)
# Po prvním startu ho NIKDY neměňte (uložené klíče by nešly dešifrovat).
LITELLM_SALT_KEY=<LITELLM_SALT_KEY>
# Přihlášení do Admin UI (http://<IP_SERVERU>:4000/ui)
UI_USERNAME=admin
UI_PASSWORD=<UI_PASSWORD>

# --- PostgreSQL ---
POSTGRES_PASSWORD=<POSTGRES_PASSWORD>
